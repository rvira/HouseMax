{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["DOM", "ES2022"],
    "types": [],
    "paths": {
      "@byright/*": ["../frontend/*"],
      "three": ["./node_modules/@types/three"]
    }
  },
  "include": ["src", "remotion.config.ts"]
}
